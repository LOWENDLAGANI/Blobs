# BLOBS runtime configuration. Copy to .env and adjust.
# Nothing here is required to boot locally beyond a Postgres database.

# Database — the whole backend (memory, conversations, tasks, settings) lives
# here. Use the Supabase *pooled* connection string:
#   Supabase dashboard → Project Settings → Database → Connection string
#   → Connection pooling → copy the URI, then replace [YOUR-PASSWORD].
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Unset, it falls back to a local Postgres for development:
#   postgresql://postgres:postgres@127.0.0.1:5432/blobs   (docker compose up -d db)
# DATABASE_URL=

# TLS is on automatically for any non-local host. Override only if needed:
# PG_SSL=require | disable
# PG_POOL_MAX=10

# Supabase project URL + service-role key. Setting both switches the owner
# login to Supabase Auth email + password — so you can sign in from any device —
# and keeps workspace files (notes, downloads, sandbox transfers) in a private
# Supabase Storage bucket created on first use, with no disk needed on the host.
# Leave them unset for the original single owner passphrase and files on disk.
#   Project Settings → API → Project URL / service_role key
# The service-role key bypasses Row Level Security: keep it server-side.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# WORKSPACE_BUCKET=blobs-workspace

# Server
PORT=3000
HOST=0.0.0.0

# Workspace files and the generated encryption key. On a host without a
# persistent volume this is the only part of BLOBS that is not in Postgres.
DATA_DIR=.data

# Optional but recommended: a 32+ character random string used to encrypt the
# integration keys stored in the database. If unset, one is generated once into
# DATA_DIR/secret.key — keep that file, or stored keys become unreadable.
# BLOBS_SECRET=

# Hosting only: used by `npm run deploy:daytona`, never read by the app itself.
# DAYTONA_API_KEY=

# Optional. Pre-seed provider keys here only if you prefer env over the UI.
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# E2B_API_KEY=
