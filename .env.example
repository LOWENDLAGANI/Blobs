# BLOBS runtime configuration. Copy to .env and adjust.
# Nothing here is required to boot: BLOBS runs with no keys at all and
# tells you which capabilities need one.

# Database. Leave unset to use the local SQLite file inside DATA_DIR.
# Set DB_URL (and DB_AUTH_TOKEN) to keep memory in Turso Cloud instead, so it
# survives a lost, rebuilt or replaced server. Adding DB_SYNC_URL turns the
# local file into an embedded replica: local-speed reads, cloud durability.
# DB_URL=libsql://<database>-<org>.turso.io
# DB_AUTH_TOKEN=
# DB_SYNC_URL=libsql://<database>-<org>.turso.io
# DB_SYNC_SECONDS=30

# Server
PORT=3000
HOST=0.0.0.0

# Where the SQLite database, workspace files and generated secrets live.
DATA_DIR=.data

# Optional. A 32+ character random string used to encrypt stored API keys.
# If unset, one is generated once into DATA_DIR/secret.key.
# BLOBS_SECRET=

# Hosting only: used by `npm run deploy:daytona`, never read by the app itself.
# Create a key at app.daytona.io → Keys.
# DAYTONA_API_KEY=

# Optional. Pre-seed a provider key here only if you prefer env over the UI.
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# E2B_API_KEY=
