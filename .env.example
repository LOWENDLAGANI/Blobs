# BLOBS runtime configuration. Copy to .env and adjust.
# Nothing here is required to boot: BLOBS runs with no keys at all and
# tells you which capabilities need one.

# Server
PORT=3000
HOST=0.0.0.0

# Where the SQLite database, workspace files and generated secrets live.
DATA_DIR=.data

# Optional. A 32+ character random string used to encrypt stored API keys.
# If unset, one is generated once into DATA_DIR/secret.key.
# BLOBS_SECRET=

# Optional. Pre-seed a provider key here only if you prefer env over the UI.
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
